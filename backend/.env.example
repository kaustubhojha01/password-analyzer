# Cyber Password Analyzer - Environment Variables
PORT=4000

# Supabase Database Connection
# Obtain these from your Supabase project dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Or use SUPABASE_SERVICE_ROLE_KEY if bypassing RLS for server-only operations
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
